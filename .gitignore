node_modules/
.wrangler/
.dev.vars
.DS_Store
Thumbs.db
*.log

# Browser "Save page as" dumps. Saving a Facebook page pulls down hundreds of
# megabytes of their JavaScript and never captures the video, so these are
# always junk -- and 36MB of it nearly ended up committed once already.
*_files/

# Raw camera footage. These are the originals straight off a phone — 130MB for
# ten clips, one of them 42MB — and only the transcoded copies in
# public/videos/ are ever served. Keeping them out stops the repository
# carrying that weight forever. Keep your own backup of the originals.
source-images/*.mov
source-images/*.MOV
source-images/*.mp4

# Gallery originals. These come straight off a phone at 5712x4284 and around
# 8MB each -- 75MB for ten of them, against a repository that is already 88MB.
# Only the built copies in public/images are ever served, and the 1600px one
# is large enough to rebuild any smaller size from, so the originals stay out.
# Keep your own backup of them.
source-images/g*.jpeg
source-images/g*.JPEG
