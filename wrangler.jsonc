{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "the-lost-boyz",

  // The site lives in public/, not the repo root. Without this, the Pages
  // build publishes the repository root and every request 404s because
  // there is no index.html up there.
  "pages_build_output_dir": "./public",

  "compatibility_date": "2026-09-08",

  // Settings the enquiry endpoint reads. These two are not secret — they are
  // just addresses — so they live here where they can be seen and changed.
  //
  // The API key is NOT here and must never be: it is a Cloudflare secret,
  // set with `wrangler pages secret put RESEND_API_KEY`. Anything committed
  // to this repository stays in the git history even after it is deleted.
  "vars": {
    // where an enquiry lands
    "BAND_EMAIL": "bookings@thelostboyz.uk",
    // who it comes from. The domain must be verified in Resend, and
    // thelostboyz.uk is.
    "FROM_EMAIL": "The Lost Boyz <website@thelostboyz.uk>"
  }
}
