{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "the-lost-boyz",

  // The site lives in public/, not the repo root. Without this, the Pages
  // build publishes the repository root and every request 404s because
  // there is no index.html up there.
  "pages_build_output_dir": "./public",

  "compatibility_date": "2026-09-08",

  // Settings the enquiry endpoint reads. These two are not secret — they are
  // just addresses — so they live here where they can be seen and changed.
  //
  // The API key is NOT here and must never be: it is a Cloudflare secret,
  // set with `wrangler pages secret put RESEND_API_KEY`. Anything committed
  // to this repository stays in the git history even after it is deleted.
  "vars": {
    // where an enquiry lands
    "BAND_EMAIL": "bookings@thelostboyz.uk",
    // who it comes from. The domain must be verified in Resend, and
    // thelostboyz.uk is.
    "FROM_EMAIL": "The Lost Boyz <website@thelostboyz.uk>",
    // where the logo in the emails is fetched from. The domain is pointed at
    // the site now, so this is the live address rather than the pages.dev one.
    "SITE_URL": "https://thelostboyz.uk",
    // Where "Approve & send to Kernow Pages" posts a submission to, so whoever
    // looks after the website gets the original file and can add it to
    // source-images properly. Change this one line if that is ever somebody
    // else; nothing else refers to the address.
    "DESIGNER_EMAIL": "manflutube@gmail.com",
    // Views the site had before the counter existed, added to the live total.
    // Set this to a real figure from Cloudflare's analytics if there is one --
    // it is a plain number here so nobody has to touch the code to change it.
    "VIEWS_SEED": "0"
  },

  // Storage.
  //
  // VIEWS  the view count. One key, read on every page and written once per
  //        visit.
  //
  // DIARY  the band's bookings, public and private, plus the enquiries that
  //        have come in through the website. Read by the admin area at /admin
  //        and, for the public gigs only, by /api/gigs and /calendar.
  //
  // The password for /admin is NOT here and must never be. It is a Cloudflare
  // secret:
  //
  //   npx wrangler pages secret put ADMIN_PASSWORD
  //
  // run once for production and once with --preview. Until it is set, /admin
  // says so plainly and lets nobody in. Changing it signs everybody out,
  // because the cookie is signed with a key derived from it.
  "kv_namespaces": [
    {
      "binding": "VIEWS",
      "id": "35f076d047884cc1b65538035e2b9b60"
    },
    {
      "binding": "DIARY",
      "id": "12c3d7e9e6c549f6b3a2ecff4dabdd2b"
    }
  ]
}
